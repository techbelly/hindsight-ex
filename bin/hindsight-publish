#!/bin/zsh
# Add a provenance note to a built history and force-push it to
# github.com/techbelly/<name>-hindsight. Usage: hindsight-publish TARGET
set -e
here=$(cd "$(dirname "$0")/.." && pwd)
t=$(basename $1); repo=$here/work/$t/repo
src=$(git -C $here/targets/$t remote get-url origin | sed 's/\.git$//')
sha=$(git -C $here/targets/$t rev-parse HEAD)
steps=$(git -C $repo log --oneline | wc -l | tr -d ' ')
cat > $repo/HINDSIGHT.md <<MD
# About this repository

This is a **synthetic git history** of [$t]($src), generated by
[hindsight](https://github.com/techbelly/hindsight-ex) from commit
[\`${sha:0:10}\`]($src/commit/$sha).

The code is the original authors' work and keeps its original licence (see
LICENSE). Comments have been removed, since a generated history has no author
whose remarks they would be. Only the commit history is fictional: hindsight
recorded which lines each test executes, ordered the tests so each adds as
little new code as possible, and replayed them one commit per test. Every
commit was checked by running the tests present at that point. Read the log
from the first commit forward to see how $t could have been built test by test.

$steps commits. Commit subjects are the test descriptions; bodies list what
each step added and whether verification needed help.
MD
git -C $repo add HINDSIGHT.md
git -C $repo -c user.name="Ben Griffiths" -c user.email="bengriffiths@gmail.com" commit -q -m "Explain where this history came from" -m "Generated with hindsight from $src at $sha."
git -C $repo remote get-url origin >/dev/null 2>&1 || git -C $repo remote add origin git@github.com:techbelly/$t-hindsight.git
git -C $repo push -q --force origin HEAD:main
echo "$t: pushed $(git -C $repo log --oneline | wc -l | tr -d ' ') commits to techbelly/$t-hindsight"
